# Copy these values from Supabase Dashboard > Connect.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Add both this URL and the deployed callback URL to Supabase Auth redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:9115

# Email address for contact form submissions. This is used in the backend to send emails.
NEXT_PUBLIC_EMAIL_CONTACT=info@lokaria.labib.click

# Keep @lokaria.test demo accounts available during local development.
# Set false in production.
NEXT_PUBLIC_ENABLE_MOCK_AUTH=true
