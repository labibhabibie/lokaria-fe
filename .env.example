# Copy these values from Supabase Dashboard > Connect.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Add both this URL and the deployed callback URL to Supabase Auth redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Keep local demo accounts available while Supabase is not configured.
NEXT_PUBLIC_ENABLE_MOCK_AUTH=true
